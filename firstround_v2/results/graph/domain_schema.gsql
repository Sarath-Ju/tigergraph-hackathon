ADD DIRECTED EDGE EDITING(FROM Film, TO Name);
// Record field 'music' naming another thing.
ADD DIRECTED EDGE MUSIC(FROM Film, TO Name);
// Record field 'distributor' naming another thing.
ADD DIRECTED EDGE DISTRIBUTOR(FROM Film, TO Name);
// Record field 'studio' naming another thing.
ADD DIRECTED EDGE STUDIO(FROM Film, TO Name);
// Record field 'has_writer' naming another thing.
ADD DIRECTED EDGE HAS_WRITER(FROM Film, TO Name);
// Record field 'screenplay' naming another thing.
ADD DIRECTED EDGE SCREENPLAY(FROM Film, TO Name);
// Record field 'based_on' naming another thing.
ADD DIRECTED EDGE BASED_ON(FROM Film, TO Name);
// Record field 'artist' naming another thing.
ADD DIRECTED EDGE ARTIST(FROM Album, TO Name);
// Record field 'label' naming another thing.
ADD DIRECTED EDGE LABEL(FROM Album, TO Name);
// Record field 'genre' naming another thing.
ADD DIRECTED EDGE GENRE(FROM Album, TO Name | FROM Writer, TO Name);
// Record field 'next_title' naming another thing.
ADD DIRECTED EDGE NEXT_TITLE(FROM Album, TO Name);
// Record field 'prev_title' naming another thing.
ADD DIRECTED EDGE PREV_TITLE(FROM Album, TO Name);
// Record field 'predecessor' naming another thing.
ADD DIRECTED EDGE PREDECESSOR(FROM Officeholder, TO Name);
// Record field 'successor' naming another thing.
ADD DIRECTED EDGE SUCCESSOR(FROM Officeholder, TO Name);
// Record field 'birth_place' naming another thing.
ADD DIRECTED EDGE BIRTH_PLACE(FROM Officeholder, TO Name | FROM Person, TO Name | FROM Writer, TO Name | FROM Scientist, TO Name);
// Record field 'party' naming another thing.
ADD DIRECTED EDGE PARTY(FROM Officeholder, TO Name);
// Record field 'birth_name' naming another thing.
ADD DIRECTED EDGE BIRTH_NAME(FROM Officeholder, TO Name | FROM Person, TO Name | FROM Writer, TO Name | FROM Scientist, TO Name);
// Record field 'education' naming another thing.
ADD DIRECTED EDGE EDUCATION(FROM Officeholder, TO Name | FROM Person, TO Name | FROM Writer, TO Name | FROM Scientist, TO Name);
// Record field 'lieutenant' naming another thing.
ADD DIRECTED EDGE LIEUTENANT(FROM Officeholder, TO Name);
// Record field 'death_place' naming another thing.
ADD DIRECTED EDGE DEATH_PLACE(FROM Officeholder, TO Name | FROM Writer, TO Name | FROM Scientist, TO Name);
// Record field 'branch' naming another thing.
ADD DIRECTED EDGE BRANCH(FROM Officeholder, TO Name);
// Record field 'president' naming another thing.
ADD DIRECTED EDGE PRESIDENT(FROM Officeholder, TO Name);
// Record field 'prime_minister' naming another thing.
ADD DIRECTED EDGE PRIME_MINISTER(FROM Officeholder, TO Name);
// Record field 'awards' naming another thing.
ADD DIRECTED EDGE AWARDS(FROM Person, TO Name);
// Record field 'location' naming another thing.
ADD DIRECTED EDGE LOCATION(FROM SkiArea, TO Name);
// Record field 'champ' naming another thing.
ADD DIRECTED EDGE CHAMP(FROM TennisTournamentEvent, TO Name);
// Record field 'runner' naming another thing.
ADD DIRECTED EDGE RUNNER(FROM TennisTournamentEvent, TO Name);
// Record field 'industry' naming another thing.
ADD DIRECTED EDGE INDUSTRY(FROM Company, TO Name);
// Record field 'has_type' naming another thing.
ADD DIRECTED EDGE HAS_TYPE(FROM Company, TO Name);
// Record field 'key_people' naming another thing.
ADD DIRECTED EDGE KEY_PEOPLE(FROM Company, TO Name);
