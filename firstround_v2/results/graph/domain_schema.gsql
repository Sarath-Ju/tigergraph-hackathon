ADD DIRECTED EDGE SECOND_OTHER(FROM InternationalFootballCompetition, TO Name);
// Record field 'third_other' naming another thing.
ADD DIRECTED EDGE THIRD_OTHER(FROM InternationalFootballCompetition, TO Name);
// Record field 'fourth_other' naming another thing.
ADD DIRECTED EDGE FOURTH_OTHER(FROM InternationalFootballCompetition, TO Name);
