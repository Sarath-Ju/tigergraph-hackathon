ADD DIRECTED EDGE HQ_LOCATION_COUNTRY(FROM Company, TO Name);
// Record field 'area_served' naming another thing.
ADD DIRECTED EDGE AREA_SERVED(FROM Company, TO Name);
// Record field 'hq_location' naming another thing.
ADD DIRECTED EDGE HQ_LOCATION(FROM Company, TO Name);
// Record field 'founder' naming another thing.
ADD DIRECTED EDGE FOUNDER(FROM Company, TO Name);
// Record field 'founders' naming another thing.
ADD DIRECTED EDGE FOUNDERS(FROM Company, TO Name);
// Record field 'tourney_name' naming another thing.
ADD DIRECTED EDGE TOURNEY_NAME(FROM InternationalFootballCompetition, TO Name);
